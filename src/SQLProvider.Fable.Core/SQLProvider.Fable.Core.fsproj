<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Portable F# only: no System.Data, no System.Linq.Expressions, no
         reflection. Everything here must survive Fable's Rust backend. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Typed SQL for F#, from one source, on .NET and through Fable on Rust, JavaScript and BEAM. The portable core: schema-typed columns, composable queries, vendor-aware SQL generation, row readers. Pair with one connector package per target.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="SqlValue.fs" />
    <Compile Include="Connector.fs" />
    <Compile Include="Dialect.fs" />
    <Compile Include="Row.fs" />
    <Compile Include="Query.fs" />
    <Compile Include="Crud.fs" />
    <Compile Include="QueryExpression.fs" />
    <Compile Include="SqlGen.fs" />
    <Compile Include="Execute.fs" />
  </ItemGroup>

  <!-- Fable consumes source, not the assembly. Shipping the .fs files in the
       package under fable/ is what makes this usable from a Fable project. -->
  <ItemGroup>
    <Content Include="*.fs" PackagePath="fable\" Pack="true" />
    <Content Include="*.fsproj" PackagePath="fable\" Pack="true" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>Fable/Rust connector for SQLProvider.Fable, over sqlx: SQLite, PostgreSQL and MySQL/MariaDB from one URL-picked code path. Needs a Fable fix (fix/rust-async) that has not shipped yet -- see the README -- and sqlx/tokio/futures in the consuming crate's Cargo.toml.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Sqlx.fs" />
    <!-- Copied next to the generated .rs and pulled in by an importAll in the
         consuming Fable project. Not compiled by MSBuild. -->
    <None Include="sqlx_native.rs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SQLProvider.Fable.Core\SQLProvider.Fable.Core.fsproj" />
    <PackageReference Include="Fable.Core" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="*.fs" PackagePath="fable\" Pack="true" />
    <Content Include="*.rs" PackagePath="fable\" Pack="true" />
    <Content Include="*.fsproj" PackagePath="fable\" Pack="true" />
  </ItemGroup>

</Project>

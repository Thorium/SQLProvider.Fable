<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="JsConnector.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SQLProvider.Fable.Core\SQLProvider.Fable.Core.fsproj" />
    <PackageReference Include="Fable.Core" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="*.fs" PackagePath="fable\" Pack="true" />
    <Content Include="*.fsproj" PackagePath="fable\" Pack="true" />
  </ItemGroup>

</Project>

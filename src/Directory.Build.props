<Project>

  <!-- Shared NuGet metadata for every package under src/. Each project adds
       its own Description; everything identity-shaped lives here once. -->
  <PropertyGroup>
    <Version>0.1.1</Version>
    <Authors>Tuomas Hietanen</Authors>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Thorium/SQLProvider.Fable</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Thorium/SQLProvider.Fable</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>fsharp;fable;sql;sqlite;postgresql;mysql;rust;sqlprovider;database</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>


</Project>

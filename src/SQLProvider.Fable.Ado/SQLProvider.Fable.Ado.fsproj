<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Description>.NET connector for SQLProvider.Fable: wraps any ADO.NET DbConnection (Microsoft.Data.Sqlite, Npgsql, MySqlConnector, ...).</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AdoConnector.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SQLProvider.Fable.Core\SQLProvider.Fable.Core.fsproj" />
  </ItemGroup>

</Project>
